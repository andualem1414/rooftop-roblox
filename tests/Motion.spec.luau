--!strict
local Test = require("./lib/Test")
local Motion = require("../src/shared/Motion")

local describe, it, expect = Test.describe, Test.it, Test.expect

describe("Motion springs", function()
	it("settle on their target", function()
		local s = Motion.spring(20, 0.6)
		for _ = 1, 60 do
			Motion.step(s, 1, 1 / 30)
		end
		expect(s.x).toBeNear(1, 1e-3)
		expect(s.v).toBeNear(0, 1e-2)
	end)
	it("ring past it a little when lightly damped, and not when critically damped", function()
		local light, firm = Motion.spring(20, 0.4), Motion.spring(20, 1)
		local peakLight, peakFirm = 0, 0
		for _ = 1, 120 do
			Motion.step(light, 1, 1 / 60)
			Motion.step(firm, 1, 1 / 60)
			peakLight = math.max(peakLight, light.x)
			peakFirm = math.max(peakFirm, firm.x)
		end
		expect(peakLight > 1.05).toBe(true)
		expect(peakFirm <= 1 + 1e-3).toBe(true)
	end)
	it("swing out from a kick and come back", function()
		local s = Motion.spring(25, 0.55)
		Motion.kick(s, 10)
		local peak = 0
		for _ = 1, 90 do
			Motion.step(s, 0, 1 / 60)
			peak = math.max(peak, s.x)
		end
		expect(peak > 0.1).toBe(true)
		expect(math.abs(s.x) < 0.01).toBe(true)
	end)
	it("don't blow up on a long frame", function()
		local s = Motion.spring(40, 0.5)
		Motion.kick(s, 50)
		Motion.step(s, 0, 5)
		expect(math.abs(s.x) < 10).toBe(true)
	end)
end)

describe("Motion.strafe", function()
	it("leaves the legs alone running ahead", function()
		local yaw, back = Motion.strafe(0, 16, 1)
		expect(yaw).toBeNear(0)
		expect(back).toBe(false)
	end)
	it("turns the legs toward a sidestep, as far as the limit", function()
		local right = Motion.strafe(16, 16, 1)
		expect(right).toBeNear(-math.pi / 4) -- (+ is to the left)
		local left = Motion.strafe(-16, 16, 1)
		expect(left).toBeNear(math.pi / 4)
		expect(Motion.strafe(16, 0, 1)).toBeNear(-1)
	end)
	it("runs backward when backing off, legs turned to match", function()
		local yaw, back = Motion.strafe(0, -16, 1)
		expect(back).toBe(true)
		expect(yaw).toBeNear(0)
		-- back and to the right: the legs face ahead and to the left, running backward
		local y2, b2 = Motion.strafe(16, -16, 1)
		expect(b2).toBe(true)
		expect(y2).toBeNear(math.pi / 4)
	end)
	it("does nothing standing still", function()
		local yaw, back = Motion.strafe(0, 0, 1)
		expect(yaw).toBe(0)
		expect(back).toBe(false)
	end)
end)

describe("Motion.kneeBend", function()
	it("bends nothing for no drop, and more for more", function()
		expect(Motion.kneeBend(0, 1.2, 1.2)).toBe(0)
		local small, big = Motion.kneeBend(0.2, 1.2, 1.2), Motion.kneeBend(0.8, 1.2, 1.2)
		expect(small > 0 and big > small).toBe(true)
	end)
	it("lowers the hips by the drop asked for", function()
		local a = Motion.kneeBend(0.5, 1.2, 1.3)
		expect((1.2 + 1.3) * (1 - math.cos(a))).toBeNear(0.5, 1e-6)
	end)
end)

describe("Motion.reachAlong", function()
	it("grips as far along as it wants when that's in reach", function()
		-- the line passes the shoulder at 0.5 to the side; a long arm reaches its whole length
		expect(Motion.reachAlong(0.5, 0, 0, 0, 0, -1, 3, 1)).toBeNear(1)
	end)
	it("stops where the arm runs out", function()
		-- 1 to the side, reach 1.25: it gets to sqrt(1.25² - 1) = 0.75 along
		expect(Motion.reachAlong(1, 0, 0, 0, 0, -1, 1.25, 2)).toBeNear(0.75)
	end)
	it("takes the nearest point when the line is out of reach", function()
		expect(Motion.reachAlong(2, 0, 1, 0, 0, -1, 1, 3)).toBeNear(1)
	end)
end)

describe("Motion shaping", function()
	it("smooths, bumps and approaches", function()
		expect(Motion.smooth(0.5, 0, 1)).toBeNear(0.5)
		expect(Motion.smooth(-1, 0, 1)).toBe(0)
		expect(Motion.bump(0.5, 0, 1)).toBeNear(1)
		expect(Motion.bump(1.2, 0, 1)).toBe(0)
		expect(Motion.approach(0, 1, 2, 0.25)).toBeNear(0.5)
		expect(Motion.approach(1, 0, 2, 1)).toBe(0)
		expect(Motion.follow(10, 0)).toBe(0)
		expect(Motion.follow(10, 10) > 0.999).toBe(true)
	end)
end)
