{
	"name": "Rooftop Race",
	"servePort": 34872,
	"tree": {
		"$className": "DataModel",
		"Workspace": {
			"$properties": { "StreamingEnabled": false }
		},
		"ReplicatedFirst": {
			"Loading": { "$path": "src/client/first" }
		},
		"ReplicatedStorage": {
			"Shared": { "$path": "src/shared" }
		},
		"ServerScriptService": {
			"Common": { "$path": "src/server/common" },
			"Race": { "$path": "src/server/race" }
		},
		"Players": {
			"$properties": { "CharacterAutoLoads": false }
		},
		"StarterPlayer": {
			"$properties": {
				"CharacterWalkSpeed": 16,
				"CharacterUseJumpPower": false,
				"CharacterJumpHeight": 3.9,
				"DevCameraOcclusionMode": "Zoom",
				"EnableMouseLockOption": false,
				"CameraMaxZoomDistance": 28,
				"CameraMinZoomDistance": 6,
				"AutoJumpEnabled": false
			},
			"StarterPlayerScripts": {
				"Common": { "$path": "src/client/common" },
				"Race": { "$path": "src/client/race" }
			},
			"StarterCharacterScripts": {
				"$path": "src/character"
			}
		}
	}
}
